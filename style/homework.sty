% =========================================================
% QUESTION BANK: \RegisterQuestion and \UseQuestion
% =========================================================
% questionbank/index.tex maps each question id (= its folder name) to its folder:
%     \RegisterQuestion{led_iv_curve}{04_diode_circuits/load_line/led_iv_curve}
% Assignment manifests then load a version of a question and assign its points:
%     \UseQuestion{led_iv_curve}{v1}{
%         basicloadline = 3,
%         ambienthot    = 5 extra,     % "extra" marks an extra-credit part
%     }
% The source is loaded with \subimport (import package), so \includegraphics paths inside it
% are relative to its version folder: {fig.png}, or {../v0/fig.png} for an earlier version.
\RequirePackage{import}
\newif\ifhwextrapart
% Catalog mode (main_questionbank.tex): questions are shown without points, every version of a
% question may appear in one document, and labels are scoped per version (see \ShowQuestion).
\newif\ifhwcatalog
\providecommand{\HwCatalogTag}{}  % printed at the right of the question title in catalog mode

% \HwPrefixRefs{prefix}: within the current group, prepend prefix to every \label, \ref, \cref and
% \Cref, so v0 and v1 of the same question (which share part labels) can coexist in one document.
\makeatletter
\newcommand{\HwPrefixRefs}[1]{%
    \edef\hw@pfx{#1}%
    \let\hw@orig@label\label
    \let\hw@orig@ref\ref
    \let\hw@orig@cref\cref
    \let\hw@orig@Cref\Cref
    \renewcommand{\label}[1]{\hw@orig@label{\hw@pfx##1}}%
    \renewcommand{\ref}[1]{\hw@orig@ref{\hw@pfx##1}}%
    \renewcommand{\cref}[1]{\hw@orig@cref{\hw@pfx##1}}%
    \renewcommand{\Cref}[1]{\hw@orig@Cref{\hw@pfx##1}}%
}
\makeatother

\ExplSyntaxOn
\prop_new:N \g__hw_qpath_prop    % question id -> folder below questionbank/
\prop_new:N \g__hw_points_prop   % part key -> points, for the question being loaded
\seq_new:N  \g__hw_extra_seq     % extra-credit part keys, for the question being loaded
\seq_new:N  \g__hw_unused_seq    % parts given points but not (yet) found in the source
\seq_new:N  \g__hw_used_ids_seq  % question ids used in this homework
\seq_new:N  \g__hw_used_keys_seq % mainquestion keys used in this homework
\tl_new:N   \g__hw_qid_tl        % id of the question being loaded (empty outside \UseQuestion)
\tl_new:N   \l__hw_dir_tl
\tl_new:N   \l__hw_extra_tl
\seq_new:N  \l__hw_match_seq
\regex_const:Nn \c__hw_points_regex { \A \s* (\d+) \s* (extra)? \s* \Z }
% Older expl3 releases (e.g. Tectonic's bundle) lack some message variants.
\cs_generate_variant:Nn \msg_warning:nnnn { nnnx }
\cs_generate_variant:Nn \msg_error:nnnn { nnnx }

\msg_new:nnn {homework} {dup-id}
  { Question~id~'#1'~is~registered~twice~in~questionbank/index.tex. }
\msg_new:nnn {homework} {unknown-id}
  { Unknown~question~id~'#1'.~Check~the~spelling~or~add~it~to~questionbank/index.tex. }
\msg_new:nnn {homework} {id-twice}
  { Question~'#1'~is~used~twice~in~this~homework. }
\msg_new:nnn {homework} {key-twice}
  { Question~key~'#1'~(question~'#2')~is~already~used~by~another~question~in~this~homework;~
    points~and~labels~would~collide.~Give~one~of~them~a~different~mainquestion~key. }
\msg_new:nnn {homework} {bad-points}
  { Invalid~points~'#2'~for~part~'#1'~of~question~'#3'.~Use~a~whole~number,~
    optionally~followed~by~'extra'~(for~example~'5~extra'). }
\msg_new:nnn {homework} {no-value}
  { Part~'#1'~of~question~'#2'~has~no~points~value~(write~'#1~=~<points>'). }
\msg_new:nnn {homework} {no-points}
  { Part~'#1'~of~question~'#2'~has~no~points~in~the~manifest;~counting~it~as~0. }
\msg_new:nnn {homework} {unused-points}
  { Points~were~given~for~part~'#1'~of~question~'#2',~but~its~source~has~no~such~part. }
\msg_new:nnn {homework} {no-usequestion}
  { Question~'#1'~was~not~loaded~with~\iow_char:N\\UseQuestion;~its~points~cannot~be~found. }
\msg_new:nnn {homework} {old-macro}
  { \iow_char:N\\#1~is~no~longer~supported:~give~points~in~the~third~argument~of~
    \iow_char:N\\UseQuestion~(see~import/import_instructions_for_LLM.md). }

\NewDocumentCommand {\RegisterQuestion} {mm}
  {
    \prop_if_in:NnT \g__hw_qpath_prop {#1} { \msg_error:nnn {homework} {dup-id} {#1} }
    \prop_gput:Nnn \g__hw_qpath_prop {#1} {#2}
  }

\cs_new_protected:Npn \__hw_add_part:nn #1#2
  {
    \regex_extract_once:NnNTF \c__hw_points_regex {#2} \l__hw_match_seq
      {
        \prop_gput:Nnx \g__hw_points_prop {#1} { \seq_item:Nn \l__hw_match_seq {2} }
        \tl_set:Nx \l__hw_extra_tl { \seq_item:Nn \l__hw_match_seq {3} }
        \tl_if_empty:NF \l__hw_extra_tl { \seq_gput_right:Nn \g__hw_extra_seq {#1} }
        \seq_gput_right:Nn \g__hw_unused_seq {#1}
      }
      { \msg_error:nnxxx {homework} {bad-points} {#1} {#2} { \g__hw_qid_tl } }
  }
\cs_new_protected:Npn \__hw_part_no_value:n #1
  { \msg_error:nnnx {homework} {no-value} {#1} { \g__hw_qid_tl } }

\cs_new_protected:Npn \__hw_subimport:n #1 { \subimport {#1} {source} }
\cs_generate_variant:Nn \__hw_subimport:n { x }

% \UseQuestion{id}{version}{part = points, ...}
\NewDocumentCommand {\UseQuestion} {mm+m}
  {
    \prop_get:NnNTF \g__hw_qpath_prop {#1} \l__hw_dir_tl
      {
        \seq_if_in:NnTF \g__hw_used_ids_seq {#1}
          { \msg_error:nnn {homework} {id-twice} {#1} }
          { \seq_gput_right:Nn \g__hw_used_ids_seq {#1} }
        \tl_gset:Nn \g__hw_qid_tl {#1}
        \prop_gclear:N \g__hw_points_prop
        \seq_gclear:N \g__hw_extra_seq
        \seq_gclear:N \g__hw_unused_seq
        \keyval_parse:NNn \__hw_part_no_value:n \__hw_add_part:nn {#3}
        \__hw_subimport:x { questionbank/\l__hw_dir_tl/#2/ }
        \seq_map_inline:Nn \g__hw_unused_seq
          { \msg_warning:nnnn {homework} {unused-points} {##1} {#1} }
        \tl_gclear:N \g__hw_qid_tl
      }
      { \msg_error:nnn {homework} {unknown-id} {#1} }
  }

% Called by mainquestion with its key.
\cs_new_protected:Npn \hw_begin_question:n #1
  {
    \tl_if_empty:NT \g__hw_qid_tl { \msg_error:nnn {homework} {no-usequestion} {#1} }
    \ifhwcatalog \else
      \seq_if_in:NnTF \g__hw_used_keys_seq {#1}
        { \msg_error:nnnx {homework} {key-twice} {#1} { \g__hw_qid_tl } }
        { \seq_gput_right:Nn \g__hw_used_keys_seq {#1} }
    \fi
  }
% Called by partquestion with its part key: sets \partpoints and \ifhwextrapart.
\cs_new_protected:Npn \hw_lookup_part:n #1
  {
    \prop_get:NnNTF \g__hw_points_prop {#1} \l_tmpa_tl
      { \cs_set:Npx \partpoints { \l_tmpa_tl } }
      {
        \ifhwcatalog \else
          \tl_if_empty:NF \g__hw_qid_tl
            { \msg_warning:nnnx {homework} {no-points} {#1} { \g__hw_qid_tl } }
        \fi
        \cs_set:Npn \partpoints {0}
      }
    \seq_gremove_all:Nn \g__hw_unused_seq {#1}
    \seq_if_in:NnTF \g__hw_extra_seq {#1} { \hwextraparttrue } { \hwextrapartfalse }
  }
% \ShowQuestion{id}{version}: catalog mode only. Loads a question version without points, with its
% labels and references scoped to that version.
\NewDocumentCommand {\ShowQuestion} {mm}
  {
    \prop_get:NnNTF \g__hw_qpath_prop {#1} \l__hw_dir_tl
      {
        \group_begin:
        \tl_gset:Nn \g__hw_qid_tl {#1}
        \prop_gclear:N \g__hw_points_prop
        \seq_gclear:N \g__hw_extra_seq
        \seq_gclear:N \g__hw_unused_seq
        \HwPrefixRefs {#1/#2:}
        \__hw_subimport:x { questionbank/\l__hw_dir_tl/#2/ }
        \group_end:
        \tl_gclear:N \g__hw_qid_tl
      }
      { \msg_error:nnn {homework} {unknown-id} {#1} }
  }
\NewDocumentCommand {\HwBeginQuestion} {m} { \hw_begin_question:n {#1} }
\NewDocumentCommand {\HwLookupPart} {m} { \hw_lookup_part:n {#1} }

% The old manifest macros: fail loudly instead of silently doing nothing.
\NewDocumentCommand {\Point} {mmm} { \msg_error:nnn {homework} {old-macro} {Point} }
\NewDocumentCommand {\MarkExtraCredit} {mm} { \msg_error:nnn {homework} {old-macro} {MarkExtraCredit} }
\ExplSyntaxOff

\newcommand{\PartPoints}{\pluralize{\partpoints}{point}{points}}

