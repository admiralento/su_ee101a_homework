% Homework header
% =========================================================
\providecommand{\AssignmentTotal}{0}
\providecommand{\ExtraCreditTotal}{0}
\providecommand{\ProblemCount}{0}
% Per-semester header settings; assignments/<Semester>/course.tex may override these.
\providecommand{\DueTime}{11:59PM}
\providecommand{\NameReminder}{Please be sure to write your name on the front page!}
% Per-question total from the .aux file; 0 on the first pass, before the .aux exists.
\newcommand{\GetProblemTotal}{%
    \ifcsname ProblemTotal\alph{questionCnt}\endcsname
        \csname ProblemTotal\alph{questionCnt}\endcsname
    \else
        0%
    \fi
}
\newcommand{\MakeHomeworkHeader}
{
    \pagestyle{fancy}
    \fancyhf{}
    \fancyhead[L]{\CourseCode/\Semester}
    \fancyfoot[L]{Compiled \DTMnow}
    \fancyfoot[R]{\thepage}
    \fancyhead[R]{\rightmark}

    \begin{center}

        \ifsolutions
            {\Large\bfseries Homework \#\HomeworkNumber{} Solutions}
            
        \else
            {\Large\bfseries Homework \#\HomeworkNumber}
            
        \fi
        \ifshowinstructor
        \vspace{0.3em}
        Instructor: \Instructor

        \fi
        \ifextracreditassignment
        \vspace{0.3em}
        {\Large\bfseries EXTRA CREDIT ASSIGNMENT}

        \fi
        \vspace{0.3em}
        Due \DueTime{} \DueDate

        \ifnum\ExtraCreditTotal>0
            Total: \pluralize{\AssignmentTotal}{Point}{Points} (\pluralize{\ExtraCreditTotal}{Point}{Points} Extra Credit)
        \else
            Total: \pluralize{\AssignmentTotal}{Point}{Points}
        \fi

        \vspace{0.5em}

        \ifsolutions
        \else
            \ifx\NameReminder\empty\else
                \textbf{\NameReminder}
            \fi
        \fi

    \end{center}
}

% =========================================================
% QUESTION ENVIRONMENT
% =========================================================
% FORMAT:
% \begin{mainquestion}{TITLE}
\NewDocumentEnvironment{mainquestion}{m +m}
{
    % save previous question before starting new one
    \StoreProblemTotal

    \stepcounter{questionCnt}
    \setcounter{partquestionCnt}{0}
    \setcounter{problempoints}{0}

    % store current key
    \gdef\currquestionkey{#1}
    \HwBeginQuestion{#1}

    % Make the Upper Right Corner Display which question we are on
    \ifhwcatalog\else
        \markright{Question \arabic{questionCnt}/\ProblemCount}
    \fi

    \bigskip
    \noindent
    {\Large\bfseries
        \ifhwcatalog
            #2
            \hfill
            \HwCatalogTag
        \else
            Question \thequestionCnt{} - #2
            \hfill
            (\pluralize{\GetProblemTotal}{point}{points})
        \fi
    }

    \medskip
}
{
    \bigskip
}

% =========================================================
% PART QUESTION ENVIRONMENT
% =========================================================
\NewDocumentEnvironment{partquestion}{m +m}
{
    \refstepcounter{partquestionCnt}

    % lookup points assigned in \UseQuestion (sets \partpoints and \ifhwextrapart)
    \HwLookupPart{#1}

    % Make a label to this portion of the question
    \edef\labelname{prob:\currquestionkey:#1}
    \label{\labelname}

    % Check if it is extra credit
    \ifhwextrapart
        % accumulate points
        \addtocounter{extracreditpoints}{\partpoints}
    
        \medskip
        \noindent
        \textbf{(\alph{partquestionCnt})}\hspace{0.5em}%
        \textbf{EXTRA CREDIT}\hspace{0.5em}%
    \else
        % accumulate totals
        \addtocounter{problempoints}{\partpoints}
        \addtocounter{assignmentpoints}{\partpoints}
    
        \medskip
        \noindent
        \textbf{(\alph{partquestionCnt})}\hspace{0.5em}%
    \fi
    #2
    \ifhwcatalog\else
        \textbf{(\PartPoints)}
    \fi
}
{
    \medskip
}

\NewDocumentEnvironment{kaitlyn}{}
{
    \begingroup
    \color{green!70!black}
}
{
    \endgroup
}

% =========================================================
% ANSWER ENVIRONMENT
% =========================================================
\ifsolutions
    \NewDocumentEnvironment{answer}{}
    {
        \par
        \vspace{1\baselineskip}
        \begingroup
        \color{blue!70!black}
    }
    {
        \endgroup
    }
\else
    \excludecomment{answer}
\fi

% =========================================================
% Final flush at end of document
% =========================================================
\AtEndDocument{%
    \StoreProblemTotal
    \StoreAssignmentTotal
    \StoreProblemCount
    \StoreExtraCreditTotal
}
